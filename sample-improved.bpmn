        <bpmndi:BPMNLabel>
          <dc:Bounds height="42" width="220" x="607.0" y="656.0"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="DataStore_AuditLog" id="DataStore_AuditLog_di">
