        <bpmndi:BPMNLabel>
          <dc:Bounds height="14" width="58" x="1689" y="455"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="DataStore_UserDB" id="DataStore_UserDB_di">
