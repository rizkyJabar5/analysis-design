      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_S3" id="Flow_S3_di">
        <di:waypoint x="790.0" y="430.0"/>
        <di:waypoint x="840.0" y="430.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_S_Pass" id="Flow_S_Pass_di">
        <di:waypoint x="890.0" y="430.0"/>
        <di:waypoint x="940.0" y="430.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds height="14" width="20" x="898" y="410"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_S_Reject" id="Flow_S_Reject_di">
        <di:waypoint x="865.0" y="455.0"/>
        <di:waypoint x="865.0" y="540.0"/>
        <di:waypoint x="1200.0" y="540.0"/>
        <di:waypoint x="1200.0" y="470.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds height="14" width="16" x="870" y="500"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_3" id="Flow_3_di">
        <di:waypoint x="1080.0" y="430.0"/>
        <di:waypoint x="1130.0" y="430.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_S4" id="Flow_S4_di">
        <di:waypoint x="1270.0" y="430.0"/>
        <di:waypoint x="1320.0" y="430.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_S5" id="Flow_S5_di">
        <di:waypoint x="1460.0" y="430.0"/>
        <di:waypoint x="1510.0" y="430.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_S6" id="Flow_S6_di">
        <di:waypoint x="1650.0" y="430.0"/>
        <di:waypoint x="1700.0" y="430.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="DIA_UserDB" id="DIA_UserDB_di">
        <di:waypoint x="720" y="600"/>
        <di:waypoint x="720" y="470"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="DOA_AuditLog" id="DOA_AuditLog_di">
        <di:waypoint x="1200" y="470"/>
        <di:waypoint x="1200" y="600"/>
      </bpmndi:BPMNEdge>
      <!-- Message flows between pools -->
      <bpmndi:BPMNEdge bpmnElement="MsgFlow_1" id="MsgFlow_1_di">
        <di:waypoint x="340.0" y="170.0"/>
        <di:waypoint x="340.0" y="390.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds height="28" width="240" x="220" y="290"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="MsgFlow_MFA" id="MsgFlow_MFA_di">
        <di:waypoint x="720.0" y="390.0"/>
