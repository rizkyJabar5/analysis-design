        <di:waypoint x="840.0" y="170.0"/>
      </bpmndi:BPMNEdge>
      <!-- System pool -->
      <bpmndi:BPMNShape bpmnElement="Participant_System" id="Participant_System_di" isHorizontal="true">
        <dc:Bounds height="400" width="1700" x="120" y="320"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="StartEvent_System" id="StartEvent_System_di">
        <dc:Bounds height="36" width="36" x="180" y="412"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds height="28" width="86" x="155" y="455"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="ServiceTask_WAF" id="ServiceTask_WAF_di">
        <dc:Bounds height="80" width="140" x="270" y="390"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="ServiceTask_ValidateInput" id="ServiceTask_ValidateInput_di">
