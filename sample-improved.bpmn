<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:open-bpmn="http://open-bpmn.org/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" exporter="Claude" exporterVersion="1.0" id="Definitions_SampleImproved" targetNamespace="http://stride.example/sample-improved">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>
      Hardened version of sample.bpmn. Original component IDs are preserved so the
      STRIDE analyzer can re-score them against their mitigations. New tasks/data-stores
      add explicit controls for every threat raised in the previous report:

        Participant_User           S  -&gt; MFA + Phishing-resistant auth (UserTask_MFA, ServiceTask_Auth)
        UserTask_Login             T,I -&gt; Client + server input validation, HTTPS only,
                                          autocomplete=off, CSRF token  (ServiceTask_ValidateInput)
        MsgFlow_1 / Flow_2 / Flow_3 I,T -&gt; TLS 1.3, certificate pinning, HMAC signature
        ServiceTask_Auth           S,T,I,D,E -&gt; OAuth2/OIDC + JWT, MFA, bcrypt/Argon2, rate limit,
                                          CAPTCHA, parameterized auth queries, audit on every attempt
        ScriptTask_Log             T,I  -&gt; Redact PII, sign each entry, hash-chain to previous (WORM)
        DataStore_AuditLog         T,R,I,D -&gt; WORM storage, signed/hash-chained entries, encrypted at
                                          rest, RBAC, log rotation + ingestion rate limit
        DataStore_UserDB           T,I,D,E -&gt; TDE + KMS keys, RBAC/ABAC, parameterized queries,
                                          DB firewall, anomaly monitoring, Argon2 password hash
        SendTask_Notify            I,T  -&gt; Encrypted channel, signed payload, no sensitive data
        ReceiveTask_Response       D,I  -&gt; Timeout + retry/backoff, encrypted response, integrity check
        Participant_System         D,I,E -&gt; WAF + rate limit + DDoS, hardened OS, least-privilege accounts
    </bpmn:documentation>
    <bpmn:participant id="Participant_User" name="User Device" processRef="Process_User"/>
    <bpmn:participant id="Participant_System" name="Backend System (hardened)" processRef="Process_System">
      <bpmn:documentation id="documentation_CWE8mw"/>
    </bpmn:participant>
    <bpmn:messageFlow id="MsgFlow_1" name="Login Request (TLS 1.3 + Cert Pinning + HMAC + CSRF)" sourceRef="UserTask_Login" targetRef="ServiceTask_WAF">
      <bpmn:documentation id="documentation_at0FlA"/>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MsgFlow_MFA" name="MFA Challenge (signed, TLS 1.3)" sourceRef="ServiceTask_Auth" targetRef="UserTask_MFA">
      <bpmn:documentation id="documentation_f0amhg"/>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MsgFlow_MFAAck" name="MFA Response (signed, TLS 1.3)" sourceRef="UserTask_MFA" targetRef="ServiceTask_Auth">
      <bpmn:documentation id="documentation_K2A4eA"/>
    </bpmn:messageFlow>
    <bpmn:messageFlow id="MsgFlow_Resp" name="Login Response (TLS 1.3, redacted, integrity-checked)" sourceRef="SendTask_Response" targetRef="ReceiveTask_Response">
      <bpmn:documentation id="documentation_ZgjCjA"/>
    </bpmn:messageFlow>
  </bpmn:collaboration>
  <!-- ============================ USER POOL ============================ -->
  <bpmn:process id="Process_User" isExecutable="false" processType="Public">
    <bpmn:documentation id="documentation_C68PTw"/>
    <bpmn:extensionElements>
      <open-bpmn:auto-align/>
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_1" name="Initiate Login">
      <bpmn:documentation id="documentation_yLcujA"/>
      <bpmn:outgoing>FlowU_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_Login" name="Fill Login Form (HTTPS, autocomplete-off, CSRF token, client-side validation)">
      <bpmn:documentation id="documentation_eJ20jA"/>
      <bpmn:incoming>FlowU_1</bpmn:incoming>
      <bpmn:outgoing>FlowU_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_MFA" name="Complete MFA (FIDO2 / WebAuthn / TOTP, device-bound)">
      <bpmn:documentation id="documentation_2zJGMQ"/>
      <bpmn:incoming>FlowU_2</bpmn:incoming>
      <bpmn:outgoing>FlowU_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:receiveTask id="ReceiveTask_Response" name="Await Response (timeout + exponential backoff retry)">
      <bpmn:documentation id="documentation_ErhSsg"/>
      <bpmn:incoming>FlowU_3</bpmn:incoming>
      <bpmn:outgoing>FlowU_4</bpmn:outgoing>
    </bpmn:receiveTask>
    <bpmn:endEvent id="EndEvent_User" name="Session Established / Failure Handled">
      <bpmn:documentation id="documentation_SaILVw"/>
      <bpmn:incoming>FlowU_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="FlowU_1" sourceRef="StartEvent_1" targetRef="UserTask_Login">
      <bpmn:documentation id="documentation_RZFMcA"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FlowU_2" sourceRef="UserTask_Login" targetRef="UserTask_MFA">
      <bpmn:documentation id="documentation_R600xg"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FlowU_3" sourceRef="UserTask_MFA" targetRef="ReceiveTask_Response">
      <bpmn:documentation id="documentation_YgrbLA"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="FlowU_4" sourceRef="ReceiveTask_Response" targetRef="EndEvent_User">
      <bpmn:documentation id="documentation_VN5jfg"/>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <!-- ============================ BACKEND POOL ============================ -->
  <bpmn:process id="Process_System" isExecutable="true" processType="Private">
    <bpmn:startEvent id="StartEvent_System" name="Inbound Login Request">
      <bpmn:documentation id="documentation_99VzKQ"/>
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MED_LoginIn"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="ServiceTask_WAF" name="WAF + Rate Limit + DDoS Mitigation + CAPTCHA (edge protection)">
      <bpmn:documentation id="documentation_3H64Ug"/>
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_S2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_ValidateInput" name="Sanitize &amp; Validate Input (allowlist + JSON schema + canonicalize)">
      <bpmn:documentation id="documentation_00xSDw"/>
      <bpmn:incoming>Flow_S2</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="ServiceTask_Auth" name="Authenticate User (OAuth2/OIDC + JWT issuer/audience + Argon2 password + MFA)">
      <bpmn:documentation id="documentation_Bd09VA"/>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
      <bpmn:property id="Prop_UserDBRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_UserDB">
        <bpmn:sourceRef>DataStore_UserDB</bpmn:sourceRef>
        <bpmn:targetRef>Prop_UserDBRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AuthOK" name="Authenticated &amp; MFA OK?">
      <bpmn:documentation id="documentation_JPuudg"/>
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_S_Pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ServiceTask_RBAC" name="RBAC / ABAC + Scope Check (least privilege)">
      <bpmn:documentation id="documentation_OkNQqQ"/>
      <bpmn:incoming>Flow_S_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="ScriptTask_Log" name="Log Activity (PII redacted, signed, hash-chained, WORM)">
      <bpmn:documentation id="documentation_0ST87g"/>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:incoming>Flow_S_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_AuditLog">
        <bpmn:targetRef>DataStore_AuditLog</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:script id="script_lTqkeg"/>
    </bpmn:scriptTask>
    <bpmn:sendTask id="SendTask_Notify" name="Send Notification (encrypted channel, signed payload, no secrets)">
      <bpmn:documentation id="documentation_K6U5nw"/>
      <bpmn:incoming>Flow_S4</bpmn:incoming>
      <bpmn:outgoing>Flow_S5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="SendTask_Response" name="Send Response (TLS 1.3, redacted, integrity-checked)">
      <bpmn:documentation id="documentation_NW9fTA"/>
      <bpmn:incoming>Flow_S5</bpmn:incoming>
      <bpmn:outgoing>Flow_S6</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="EndEvent_System" name="Done">
      <bpmn:documentation id="documentation_Ht6nVQ"/>
      <bpmn:incoming>Flow_S6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStore_UserDB" name="User Database (TDE + KMS, RBAC/ABAC, parameterized queries, Argon2 hash, DB firewall, anomaly monitoring)">
      <bpmn:documentation id="documentation_X0wRzw"/>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DataStore_AuditLog" name="Audit Log (WORM, hash-chained, signed entries, encrypted at rest, restricted access, rotation/archive)">
      <bpmn:documentation id="documentation_ahQ9rg"/>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="StartEvent_System" targetRef="ServiceTask_WAF">
      <bpmn:documentation id="documentation_OTI7ew"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S2" sourceRef="ServiceTask_WAF" targetRef="ServiceTask_ValidateInput">
      <bpmn:documentation id="documentation_Yr1Qaw"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" name="Validated (TLS + HMAC)" sourceRef="ServiceTask_ValidateInput" targetRef="ServiceTask_Auth">
      <bpmn:documentation id="documentation_eJzd6w"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="ServiceTask_Auth" targetRef="Gateway_AuthOK">
      <bpmn:documentation id="documentation_RehXuQ"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S_Reject" name="No" sourceRef="Gateway_AuthOK" targetRef="ScriptTask_Log">
      <bpmn:documentation id="documentation_6EJpeg"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S_Pass" name="Yes" sourceRef="Gateway_AuthOK" targetRef="ServiceTask_RBAC">
      <bpmn:documentation id="documentation_kM5pGQ"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_3" name="Authorized (mTLS internal)" sourceRef="ServiceTask_RBAC" targetRef="ScriptTask_Log">
      <bpmn:documentation id="documentation_Ebqlfg"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="ScriptTask_Log" targetRef="SendTask_Notify">
      <bpmn:documentation id="documentation_ja6P8Q"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="SendTask_Notify" targetRef="SendTask_Response">
      <bpmn:documentation id="documentation_VA6GJw"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_S6" sourceRef="SendTask_Response" targetRef="EndEvent_System">
      <bpmn:documentation id="documentation_rdHKBQ"/>
    </bpmn:sequenceFlow>
  </bpmn:process>
  <!-- ============================ DIAGRAM ============================ -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane bpmnElement="Collaboration_1" id="BPMNPlane_1">
