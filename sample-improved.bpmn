        <bpmndi:BPMNLabel>
          <dc:Bounds height="28" width="90" x="820" y="370"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="ServiceTask_RBAC" id="ServiceTask_RBAC_di">
