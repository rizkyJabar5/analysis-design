        <di:waypoint x="270.0" y="170.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="FlowU_2" id="FlowU_2_di">
        <di:waypoint x="410.0" y="170.0"/>
        <di:waypoint x="460.0" y="170.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="FlowU_3" id="FlowU_3_di">
        <di:waypoint x="600.0" y="170.0"/>
        <di:waypoint x="650.0" y="170.0"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="FlowU_4" id="FlowU_4_di">
