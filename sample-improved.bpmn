        <di:waypoint x="700.0" y="320.0"/>
        <di:waypoint x="700.0" y="390.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds height="14" width="180" x="580" y="270"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="MsgFlow_Resp" id="MsgFlow_Resp_di">
        <di:waypoint x="1580.0" y="390.0"/>
        <di:waypoint x="1580.0" y="280.0"/>
        <di:waypoint x="720.0" y="280.0"/>
        <di:waypoint x="720.0" y="210.0"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds height="14" width="280" x="900" y="255"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
