@startuml secure-login-flow
' Sample PUML for parser tests — hardened against the STRIDE findings from the backend.
title Sample Login Flow (STRIDE-Hardened)
skinparam shadowing false

actor "End User" as user
participant "CDN + WAF" as waf
participant "Web App" as web
boundary "Auth Gateway" as authgw
control     "Auth Service"   as auth
entity      "Secret Manager" as vault
participant "DB Firewall"    as dbfw
database    "User DB"        as udb
queue       "Audit Queue"    as q
participant "SIEM"           as siem

user   -->  waf    : HTTPS request
waf    -->  web    : forward over TLS
web    -->  web    : input validation
web    --> authgw : credentials (mTLS)
authgw ->  auth   : validate
auth   ->  vault  : fetch signing keys
auth   ->  dbfw   : query user
dbfw   -->  udb    : authorized SELECT
udb    --> dbfw   : profile
dbfw   --> auth   : profile
auth   --> q      : signed audit event
q      --> siem   : ship logs
auth   --> web    : generic reject on invalid
@enduml
