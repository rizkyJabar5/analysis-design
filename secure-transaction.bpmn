<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:open-bpmn="http://open-bpmn.org/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" exporter="Claude" exporterVersion="2.0" id="Definitions_SecureTransaction" targetNamespace="http://stride.example/secure">
  <bpmn:process id="Process_SecurePayment" isExecutable="true" name="Secure User Payment Transaction" processType="Public">
    <bpmn:documentation>
      End-to-end secure user payment transaction.
      Controls mapped to the components flagged by the STRIDE analyzer:

        Mobile App (Client)
          - Jailbreak/Root detection, Cert pinning, RASP, Code signing (Task_DeviceAttest)
          - Biometric / FIDO2 / WebAuthn + MFA, Secure Keystore (Task_BiometricMFA)

        Internet / Public Network
          - TLS 1.3, HSTS, Cert pinning, WAF/CDN, DDoS mitigation, Rate Limit (Task_EdgeProtect)

        API Gateway
          - OAuth2 / OIDC, JWT issuer/audience validation, OpenAPI schema validation,
            input sanitization, mTLS service-to-service, signed requests (Task_AuthnValidate)
          - RBAC / ABAC, OPA policy enforcement, scope check (Task_AuthzPolicy)

        Application Server
          - Parameterized queries, allowlist input validation (Task_SanitizeQuery)
          - Fraud / velocity / anomaly detection, behavioral monitoring (Task_FraudCheck)
          - PCI Tokenization through HSM-backed Vault / KMS (Task_Tokenize)
          - Centralized logging with PII redaction (Task_RedactedLog)

        Third-Party Service (PSP)
          - mTLS, signed payload, circuit breaker, retry/backoff (Task_CallPSP)
          - Verify PSP response signature (HMAC / JWS) and schema (Task_VerifyPSP)

        Database
          - Transparent Data Encryption (TDE), KMS-managed keys, encrypted backups,
            RBAC, audit triggers, query timeouts, constraints (DataStore_TxDB + DataStore_Backup)
          - Immutable WORM audit log, signed entries (Task_AuditLog + DataStore_AuditLog)

        User
          - Session binding, device fingerprinting, masked UI, RBAC/ABAC (EndEvent_OK)
    </bpmn:documentation>
    <bpmn:extensionElements>
      <open-bpmn:auto-align/>
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_1" name="Begin Transaction">
      <bpmn:documentation id="documentation_WV0CGQ"/>
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_DeviceAttest" name="Device Attestation (Jailbreak/Root Detection, Cert Pinning, RASP, Code Signing)">
      <bpmn:documentation id="documentation_BRmQrQ"/>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_BiometricMFA" name="Biometric Login + MFA (FIDO2/WebAuthn, Secure Keystore)">
      <bpmn:documentation id="documentation_bBDkrw"/>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_EdgeProtect" name="Edge Protection (TLS 1.3 + HSTS + Cert Pinning + WAF + DDoS Mitigation + Rate Limit)">
      <bpmn:documentation id="documentation_C1Lz7g"/>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AuthnValidate" name="Validate OAuth2/OIDC + JWT (issuer/audience) + OpenAPI Schema + HMAC Signature">
      <bpmn:documentation id="documentation_laxRLQ"/>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Auth" name="Authenticated?">
      <bpmn:documentation id="documentation_HjJzdg"/>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_NoAuth</bpmn:outgoing>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_Reject" name="Reject 401/403 + Sanitized Error + Audit">
      <bpmn:documentation id="documentation_yAqD9w"/>
      <bpmn:incoming>Flow_NoAuth</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_AuthzPolicy" name="RBAC/ABAC + OPA Policy + Scope Check (least privilege)">
      <bpmn:documentation id="documentation_xCq5Rg"/>
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SanitizeQuery" name="Input Validation + Allowlist + Parameterized Queries (anti-injection)">
      <bpmn:documentation id="documentation_dAkzBA"/>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_FraudCheck" name="Fraud + Velocity + Anomaly Detection (behavioral monitoring)">
      <bpmn:documentation id="documentation_rdlM9A"/>
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Tokenize" name="Tokenize PAN via HSM Vault + KMS (PCI DSS)">
      <bpmn:documentation id="documentation_UQDK5w"/>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
      <bpmn:property id="Prop_VaultRef" name="__targetRef_placeholder"/>
      <bpmn:dataInputAssociation id="DIA_Vault">
        <bpmn:sourceRef>DataStore_Vault</bpmn:sourceRef>
        <bpmn:targetRef>Prop_VaultRef</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CallPSP" name="Call PSP via mTLS + Signed Payload + Circuit Breaker + Retry/Backoff">
      <bpmn:documentation id="documentation_mgBSBw"/>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_VerifyPSP" name="Verify PSP Response Signature (HMAC/JWS) + Schema Validation">
      <bpmn:documentation id="documentation_hffjMA"/>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Persist" name="Persist Transaction (TDE + KMS Keys + Constraints + Query Timeout + RBAC)">
      <bpmn:documentation id="documentation_y0m00A"/>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_TxDB">
        <bpmn:targetRef>DataStore_TxDB</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DOA_Backup">
        <bpmn:targetRef>DataStore_Backup</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Task_AuditLog" name="Sign &amp; Append Audit Log (WORM, immutable, tamper-evident)">
      <bpmn:documentation id="documentation_2R5Vcw"/>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Audit">
        <bpmn:targetRef>DataStore_AuditLog</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:script id="script_a3becA"/>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="Task_RedactedLog" name="Centralized Logging with PII/Token Redaction (encrypted at rest)">
      <bpmn:documentation id="documentation_HYxHuw"/>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_Logs">
        <bpmn:targetRef>DataStore_Logs</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_OK" name="Signed Masked Receipt (no PAN, session-bound)">
      <bpmn:documentation id="documentation_SGllUw"/>
      <bpmn:incoming>Flow_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStore_Vault" name="Secrets Vault (HSM + KMS, rotating keys)">
      <bpmn:documentation id="documentation_FmgpyQ"/>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DataStore_TxDB" name="Transactions DB (TDE, KMS, RBAC, audit triggers)">
      <bpmn:documentation id="documentation_NBiqsg"/>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DataStore_Backup" name="Encrypted Off-site Backup (TDE)">
      <bpmn:documentation id="documentation_mKqS6Q"/>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DataStore_AuditLog" name="Immutable Audit Log (WORM, signed)">
      <bpmn:documentation id="documentation_c0QBHQ"/>
    </bpmn:dataStoreReference>
    <bpmn:dataStoreReference id="DataStore_Logs" name="Centralized Logs (redacted, encrypted, restricted access)">
      <bpmn:documentation id="documentation_4y03xw"/>
    </bpmn:dataStoreReference>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_DeviceAttest">
      <bpmn:documentation id="documentation_NqMVgQ"/>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_DeviceAttest" targetRef="Task_BiometricMFA">
